{
	"manifest_version": 3,
	"name": "RTA Arkylizer",
	"version": "1.0.1",
	"description": "Reads the Epic Seven match-history battle list straight from the page and renders a performance analysis: rank by match, points per match, sessions, warm-up, hero effectiveness and behaviour tags. English / Vietnamese.",
	"host_permissions": ["https://epic7.onstove.com/*", "https://e7api.onstove.com/*"],
	"permissions": ["storage", "unlimitedStorage"],
	"icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
	"content_scripts": [
		{
			"matches": ["https://epic7.onstove.com/*"],
			"js": ["src/inject.js"],
			"run_at": "document_start",
			"world": "MAIN"
		},
		{
			"matches": ["https://epic7.onstove.com/*"],
			"js": ["vendor/chart.umd.js", "src/heroes.js", "src/artifacts.js", "src/i18n.js", "src/aggregate.js", "src/render.js", "src/content.js"],
			"run_at": "document_start",
			"css": ["src/styles.css"]
		}
	],
	"action": {
		"default_title": "RTA Arkylizer",
		"default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
	}
}
